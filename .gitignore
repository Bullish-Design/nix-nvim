# devenv
.devenv/
.devenv.flake.nix
devenv.local.nix

# direnv
.direnv/

# python venv / caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# copyroom scratch (template-edit previews/worktrees)
.copyroom/

# nix build outputs
result
result-*

# colocated jj + local scratch — but keep the shareable .scratch/projects/ docs
# tracked (fleet convention: repoman et al. version project docs there).
.jj/
.scratch/*
!.scratch/projects/

# Agent-files convention: the central Devman link plane owns .agents and
# .claude. Both are symlinks, and neither is tracked in this project.
# Write the names with no trailing slash. A trailing slash matches only a real
# directory, not a symlink.
!AGENTS.md
!CLAUDE.md
.agents
.claude
.testee/
