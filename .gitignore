# devenv
.devenv/
.devenv.flake.nix
devenv.local.nix

# direnv
.direnv/

# python venv / caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# copyroom scratch (template-edit previews/worktrees)
.copyroom/

# nix build outputs
result
result-*

# colocated jj + local scratch — but keep the shareable .scratch/projects/ docs
# tracked (fleet convention: repoman et al. version project docs there).
.jj/
.scratch/*
!.scratch/projects/

# Agent-files convention (see AGENTS.md): .agents/skills/ (skills) are tracked,
# as are AGENTS.md and CLAUDE.md. The rest of .agents/ (e.g. .agents/pi/) is
# platform/tool runtime state and stays ignored — .agents/ is dual-use on purpose.
.agents/**
!.agents/skills/
!.agents/skills/**
!AGENTS.md
!CLAUDE.md
