# devenv
.devenv/
.devenv.flake.nix
devenv.local.nix

# direnv
.direnv/

# python venv / caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# copyroom scratch (template-edit previews/worktrees)
.copyroom/

# nix build outputs
result
result-*

# colocated jj + local scratch — but keep the shareable .scratch/projects/ docs
# tracked (fleet convention: repoman et al. version project docs there).
.jj/
.scratch/*
!.scratch/projects/

# `.agents/` is machine-local: the devman central overlay owns it (a symlink
# to ~/.config/devman/projects/<p>/agents). Nothing under it is tracked — the
# router is generated by `repoman install-skills` and the pool skills are links.
# AGENTS.md and CLAUDE.md stay committed by design.
.agents
